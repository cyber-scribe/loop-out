# AI Service Configuration (Groq OpenAI-compatible API)
# Leave AI_API_KEY empty to run in local Mock/Fallback mode with safe curated resets
AI_API_KEY=""
AI_API_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL="openai/gpt-oss-20b"
AI_PROVIDER="groq"

# Backend Server Configuration
PORT=8000
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"

# Frontend Configuration (optional, defaults to /api when hosted together)
VITE_API_BASE_URL=""

